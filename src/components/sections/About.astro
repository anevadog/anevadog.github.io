---
import SectionHeading from "../ui/SectionHeading.astro";

// RF-10 (ADR-013). Cifras confirmadas en ADR-015.
const stats = [
  { value: 8, prefix: "", label: "años en soporte IT y Service Desk" },
  { value: 50, prefix: "+", label: "clientes en mi servicio técnico" },
  {
    value: 715,
    prefix: "",
    label: "tests automatizados en mi proyecto principal",
  },
];

// Trayectoria dibujada como una pista de circuito (ADR-016): cobre para
// sistemas y soporte, esmeralda para desarrollo. Fechas del CV (ADR-015).
const trajectory = [
  {
    period: "2013–2015",
    title: "Técnico en Sistemas",
    detail: "SENA",
    stage: "it",
  },
  {
    period: "2016–2020",
    title: "Soporte IT / Service Desk",
    detail: "Neumática del Caribe",
    stage: "it",
  },
  {
    period: "2020–2024",
    title: "Fundador y técnico",
    detail: "SoftHard A&L, mi servicio técnico",
    stage: "it",
  },
  {
    period: "2025–hoy",
    title: "CFGS Desarrollo de Aplicaciones Multiplataforma",
    detail: "CEAC",
    stage: "dev",
  },
  {
    period: "2026",
    title: "Tres proyectos publicados",
    detail: "SoftHard A&L, Cocina y Pendla",
    stage: "dev",
  },
] as const;

const stageClasses = {
  it: "border-accent-2 before:border-accent-2",
  dev: "border-accent before:border-accent",
};
const periodClasses = { it: "text-accent-2", dev: "text-accent" };
---

<section id="sobre-mi" aria-labelledby="sobre-mi-titulo">
  <div class="mx-auto flex max-w-6xl flex-col gap-16 px-4 py-24 sm:px-6 lg:gap-20 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.35fr] lg:gap-16">
      <SectionHeading
        id="sobre-mi-titulo"
        eyebrow="sobre mí"
        title="De mantener sistemas a construirlos"
      />

      <div class="flex flex-col gap-10">
        <div
          data-reveal
          class="flex max-w-2xl flex-col gap-4 text-lg text-pretty text-text-muted"
        >
          <p>
            Llevo <strong class="font-medium text-text">8 años</strong>{" "}
            resolviendo problemas técnicos: primero como técnico de Service Desk
            y después dirigiendo mi propio servicio técnico,{" "}
            <strong class="font-medium text-text">SoftHard A&L</strong>, con más
            de 50 clientes entre particulares y pequeñas empresas. Ese trabajo
            me enseñó a diagnosticar con método, a explicar lo técnico con
            claridad y a entender qué necesita de verdad cada usuario.
          </p>
          <p>
            Ahora llevo esa experiencia al desarrollo. Curso el{" "}
            <strong class="font-medium text-text">
              CFGS de Desarrollo de Aplicaciones Multiplataforma
            </strong>{" "}
            y me formo en backend con Java. Además, he construido una aplicación
            web full stack para gestionar un taller de reparación, dirigiendo
            agentes de IA a partir de mi conocimiento del negocio. Busco
            prácticas de desarrollo o un puesto de soporte con proyección
            técnica.
          </p>
        </div>

        <ul
          data-reveal
          class="grid gap-x-6 border-t border-border-strong sm:grid-cols-3"
        >
          {stats.map((stat) => (
            <li class="flex items-baseline gap-4 pt-5 sm:flex-col sm:gap-1.5">
              <span
                data-count={stat.value}
                data-count-prefix={stat.prefix}
                class="min-w-32 font-display text-5xl leading-none font-extrabold tracking-tight text-accent-2 tabular-nums [font-stretch:118%] lg:text-6xl"
              >
                {stat.prefix}
                {stat.value}
              </span>
              <span class="max-w-52 text-sm text-text-muted">{stat.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <h3
        data-reveal
        class="font-mono text-xs tracking-widest text-text-muted uppercase"
      >
        Trayectoria
      </h3>
      <ol class="grid lg:grid-cols-5">
        {trajectory.map((step) => (
          <li
            data-reveal
            class:list={[
              "relative flex flex-col gap-1 border-l-2 pb-7 pl-7 last:pb-0 lg:border-t-2 lg:border-l-0 lg:pt-6 lg:pr-5 lg:pb-0 lg:pl-0",
              "before:absolute before:top-0 before:-left-2 before:size-3.5 before:rounded-full before:border-[3px] before:bg-bg lg:before:-top-2 lg:before:left-0",
              stageClasses[step.stage],
            ]}
          >
            <span
              class:list={[
                "font-mono text-xs tracking-wider uppercase",
                periodClasses[step.stage],
              ]}
            >
              {step.period}
            </span>
            <span class="leading-snug font-semibold">{step.title}</span>
            <span class="text-sm text-text-muted">{step.detail}</span>
          </li>
        ))}
      </ol>
      <p
        data-reveal
        class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wider text-text-muted uppercase"
      >
        <span class="inline-flex items-center gap-2 before:h-0.5 before:w-5 before:bg-accent-2">
          Sistemas y soporte
        </span>
        <span class="inline-flex items-center gap-2 before:h-0.5 before:w-5 before:bg-accent">
          Desarrollo
        </span>
      </p>
    </div>
  </div>
</section>
