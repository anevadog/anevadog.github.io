---
import ProjectCard from "./ProjectCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { projects } from "../../data/projects";

// Los proyectos publicados alternan el lado de la captura y llevan un
// designador de componente (U1, U2…), como los chips de una placa (ADR-016).
let published = 0;
const cards = projects.map((project) => ({
  project,
  position: project.status === "published" ? ++published : 0,
}));
---

<section
  id="proyectos"
  aria-labelledby="proyectos-titulo"
  class="border-y border-border bg-surface"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-14 px-4 py-24 sm:px-6 lg:gap-20 lg:py-28">
    <SectionHeading
      id="proyectos-titulo"
      eyebrow="proyectos"
      title="Proyectos destacados"
      description="Lo que construyo para aprender y para resolver problemas reales."
    />

    <ul class="flex flex-col gap-20 lg:gap-28">
      {cards.map(({ project, position }) => (
        <ProjectCard {project} {position} />
      ))}
    </ul>
  </div>
</section>
