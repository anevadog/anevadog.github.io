---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tag from "../ui/Tag.astro";
import { resume, type ResumeEntry } from "../../data/resume";
import { publicPath } from "../../utils/paths";

// RF-05 / RF-06 (ADR-004): CV en HTML; descarga solo si hay PDF.
const timeline: { heading: string; entries: ResumeEntry[] }[] = [
  { heading: "Experiencia", entries: resume.experience },
  { heading: "Formación", entries: resume.education },
];
---

<section id="cv" aria-labelledby="cv-titulo" class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 sm:px-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading
        id="cv-titulo"
        index="03"
        eyebrow="currículum"
        title="Currículum"
      />
      {resume.pdf ? (
        <Button
          href={publicPath(`cv/${resume.pdf.file}`)}
          download={resume.pdf.downloadName}
        >
          <Icon name="download" class="size-4" />
          Descargar PDF
        </Button>
      ) : (
        <p class="font-mono text-xs text-text-muted">
          Versión en PDF disponible próximamente.
        </p>
      )}
    </div>

    <div class="grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div class="flex flex-col gap-12">
        {timeline.map(({ heading, entries }) => (
          <div class="flex flex-col gap-6">
            <h3 class="text-xl font-semibold">{heading}</h3>
            <ol class="flex flex-col gap-8 border-l border-border">
              {entries.map((entry) => (
                <li class="relative flex flex-col gap-2 pl-6 before:absolute before:top-2 before:-left-[5px] before:size-[9px] before:rounded-full before:bg-accent before:ring-4 before:ring-bg">
                  <div class="flex flex-col gap-0.5">
                    <h4 class="font-semibold">{entry.title}</h4>
                    <p class="font-mono text-xs text-text-muted">
                      {entry.organization} · {entry.period}
                    </p>
                  </div>
                  {entry.bullets && (
                    <ul class="flex flex-col gap-1.5 text-sm text-pretty text-text-muted">
                      {entry.bullets.map((bullet) => (
                        <li class="flex gap-2">
                          <span
                            aria-hidden="true"
                            class="font-mono text-accent"
                          >
                            ›
                          </span>
                          <span>{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>

      <div class="flex flex-col gap-10">
        <div class="flex flex-col gap-6">
          <h3 class="text-xl font-semibold">Competencias técnicas</h3>
          {resume.skills.map((group) => (
            <div class="flex flex-col gap-3">
              <div>
                <h4 class="text-sm font-semibold">{group.name}</h4>
                {group.note && (
                  <p class="font-mono text-xs text-text-muted">{group.note}</p>
                )}
              </div>
              <ul class="flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li>
                    <Tag>{item}</Tag>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xl font-semibold">Idiomas</h3>
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            {resume.languages.map((language) => (
              <>
                <dt class="font-medium">{language.name}</dt>
                <dd class="text-text-muted">{language.level}</dd>
              </>
            ))}
          </dl>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xl font-semibold">Competencias personales</h3>
          <ul class="flex flex-wrap gap-2">
            {resume.personalSkills.map((skill) => (
              <li>
                <Tag tone="accent">{skill}</Tag>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-3">
          <h3 class="text-xl font-semibold">Información adicional</h3>
          <ul class="flex flex-col gap-1.5 text-sm text-text-muted">
            {resume.additional.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
