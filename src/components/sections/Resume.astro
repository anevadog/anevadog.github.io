---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tag from "../ui/Tag.astro";
import { resume } from "../../data/resume";
import { publicPath } from "../../utils/paths";

// RF-05 / RF-06 (ADR-004): CV en HTML; descarga solo si hay PDF.
const facts = [
  {
    label: "Idiomas",
    value: resume.languages
      .map((language) => `${language.name} (${language.level})`)
      .join(" · "),
  },
  { label: "Personales", value: resume.personalSkills.join(" · ") },
  { label: "Además", value: resume.additional.join(" · ") },
];

const subheading = "font-display text-xl font-bold [font-stretch:112%]";
---

<section id="cv" aria-labelledby="cv-titulo">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 sm:px-6 lg:gap-16 lg:py-28">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <SectionHeading id="cv-titulo" eyebrow="currículum" title="Currículum" />
      {resume.pdf ? (
        <Button
          href={publicPath(`cv/${resume.pdf.file}`)}
          download={resume.pdf.downloadName}
        >
          <Icon name="download" class="size-4" />
          Descargar PDF
        </Button>
      ) : (
        <p class="font-mono text-xs text-text-muted">
          Versión en PDF disponible próximamente.
        </p>
      )}
    </div>

    <div class="grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:gap-16">
      <div class="flex flex-col gap-12">
        <div class="flex flex-col gap-6">
          <h3 class={subheading}>Experiencia</h3>
          <ol class="flex flex-col gap-9">
            {resume.experience.map((entry) => (
              <li
                data-reveal
                class="flex flex-col gap-3 border-l-2 border-border pl-6"
              >
                <div class="flex flex-col gap-1">
                  <h4 class="text-lg leading-snug font-semibold">
                    {entry.title}
                  </h4>
                  <p class="font-mono text-xs tracking-wider text-accent-2 uppercase">
                    {entry.organization} · {entry.period}
                  </p>
                </div>
                {entry.bullets && (
                  <ul class="flex flex-col gap-2 text-sm text-pretty text-text-muted">
                    {entry.bullets.map((bullet) => (
                      <li class="relative pl-4 before:absolute before:top-[0.65em] before:left-0 before:h-0.5 before:w-1.5 before:bg-border-strong">
                        {bullet}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </div>

        <div data-reveal class="flex flex-col gap-4">
          <h3 class={subheading}>Formación</h3>
          <ul>
            {resume.education.map((entry) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-border py-3.5">
                <span class="font-semibold">{entry.title}</span>
                <span class="font-mono text-xs tracking-wider text-text-muted uppercase">
                  {entry.organization} · {entry.period}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex flex-col gap-6">
        <h3 class={subheading}>Competencias técnicas</h3>
        <!-- El primer grupo (experiencia profesional) destaca sobre el resto. -->
        {resume.skills.map((group, index) => (
          <div
            data-reveal
            class:list={[
              "flex flex-col gap-3 rounded-lg border bg-surface p-5",
              index === 0 ? "border-border-strong" : "border-border",
            ]}
          >
            <div class="flex flex-col gap-1">
              <h4 class="text-sm font-semibold">{group.name}</h4>
              {group.note && (
                <p
                  class:list={[
                    "font-mono text-xs tracking-wider uppercase",
                    index === 0 ? "text-accent-2" : "text-text-muted",
                  ]}
                >
                  {group.note}
                </p>
              )}
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <dl data-reveal class="flex flex-col text-sm">
          {facts.map((fact) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 border-t border-border py-3">
              <dt class="pt-0.5 font-mono text-xs tracking-wider text-text-muted uppercase">
                {fact.label}
              </dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>
