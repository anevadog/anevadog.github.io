---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import Tag from "../ui/Tag.astro";
import { requestAccessHref, type Project } from "../../data/projects";

interface Props {
  project: Project;
  /** Orden entre los proyectos publicados (1, 2…): designador y lado de la captura. */
  position?: number;
}

const { project, position = 1 } = Astro.props;
const flip = position % 2 === 0;
---

{project.status === "upcoming" ? (
  <li
    data-reveal
    class="flex flex-col items-start gap-3 rounded-lg border border-dashed border-border-strong p-6"
  >
    <span class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted">
      <Icon name="clock" class="size-4" />
      en desarrollo
    </span>
    <h3 class="text-lg font-semibold">Próximo proyecto</h3>
    <p class="text-sm text-text-muted">
      Proyecto personal en curso. Se publicará aquí, con su repositorio, en
      cuanto esté terminado.
    </p>
  </li>
) : (
  <li
    data-reveal
    class="group/card grid items-center gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-16"
  >
    <!-- Captura en un marco de ventana; se inclina al pasar por la tarjeta
           (solo `transform`). -->
    <figure
      class:list={[
        "min-w-0 overflow-hidden rounded-lg border border-border-strong bg-bg shadow-elevated transition-transform duration-500 ease-soft motion-reduce:transform-none",
        flip
          ? "lg:order-2 lg:group-hover/card:transform-[perspective(1400px)_rotateY(3deg)_rotateX(1.5deg)_scale(1.015)]"
          : "lg:group-hover/card:transform-[perspective(1400px)_rotateY(-3deg)_rotateX(1.5deg)_scale(1.015)]",
      ]}
    >
      <div class="flex items-center gap-3 border-b border-border px-3 py-2">
        <span aria-hidden="true" class="flex gap-1.5">
          <span class="size-2 rounded-full bg-border-strong opacity-60" />
          <span class="size-2 rounded-full bg-border-strong opacity-60" />
          <span class="size-2 rounded-full bg-border-strong opacity-60" />
        </span>
        <span class="min-w-0 truncate font-mono text-xs text-text-muted">
          {project.frameLabel}
        </span>
        <span
          aria-hidden="true"
          class="ml-auto rounded-sm bg-chip px-1.5 py-0.5 font-mono text-xs text-silk"
        >
          U{position}
        </span>
      </div>
      <div class="relative isolate flex aspect-video items-center justify-center overflow-hidden">
        {project.image ? (
          <Image
            src={project.image}
            alt={project.imageAlt ?? ""}
            class="size-full object-cover"
          />
        ) : (
          <span
            aria-hidden="true"
            class="font-mono text-lg text-text before:text-accent before:content-['~/'] sm:text-xl"
          >
            {project.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}
          </span>
        )}
      </div>
    </figure>

    <div class="flex min-w-0 flex-col gap-5">
      <div class="flex flex-col gap-1.5">
        <p class="font-mono text-xs tracking-wider text-text-muted uppercase">
          Proyecto personal · {project.year}
        </p>
        <h3 class="font-display text-3xl leading-[1.05] font-bold tracking-tight [font-stretch:112%] lg:text-4xl">
          {project.title}
        </h3>
        <p class="text-lg font-medium">{project.subtitle}</p>
      </div>

      <p class="text-sm text-pretty text-text-muted">{project.description}</p>

      <p class="flex items-center gap-4 border-y border-border py-3.5">
        <span class="font-display text-5xl leading-none font-extrabold tracking-tight text-accent-2 tabular-nums [font-stretch:118%]">
          {project.metric.value}
        </span>
        <span class="text-sm leading-snug text-text-muted">
          {project.metric.label}
        </span>
      </p>

      <ul class="flex flex-col gap-2.5 text-sm text-pretty">
        {project.highlights.map((highlight) => (
          <li class="relative pl-5 before:absolute before:top-[0.6em] before:left-0 before:h-0.5 before:w-2 before:bg-accent">
            {highlight}
          </li>
        ))}
      </ul>

      <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologías">
        {project.tech.map((tech) => (
          <li>
            <Tag>{tech}</Tag>
          </li>
        ))}
      </ul>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        {project.demoUrl && (
          <Button href={project.demoUrl} external>
            Ver demo
            <Icon name="external" class="size-4" />
          </Button>
        )}
        {"url" in project.repo ? (
          <Button variant="secondary" href={project.repo.url} external>
            <Icon name="github" class="size-4" />
            Repositorio
          </Button>
        ) : (
          <>
            <span class="inline-flex items-center gap-1.5 text-sm text-text-muted">
              <Icon name="lock" class="size-4" />
              Repositorio privado
            </span>
            <Button variant="secondary" href={requestAccessHref(project)}>
              Solicitar acceso
            </Button>
          </>
        )}
      </div>
    </div>
  </li>
)}
