---
/* Encabezado común de sección: índice y etiqueta en monoespaciada, y título. */
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, index, eyebrow, title, description } = Astro.props;
---

<div data-reveal class="flex flex-col gap-3">
  <p class="font-mono text-sm text-accent">
    <span class="text-text-muted">{`${index} · `}</span>
    {eyebrow}
  </p>
  <h2 {id} class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">
    {title}
  </h2>
  {description && <p class="max-w-2xl text-text-muted">{description}</p>}
</div>
