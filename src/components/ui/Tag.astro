---
/* Etiqueta en fuente monoespaciada, pensada para tecnologías de un proyecto. */
interface Props {
  tone?: "neutral" | "accent";
  class?: string;
}

const { tone = "neutral", class: className } = Astro.props;

const tones = {
  neutral: "border-border bg-surface text-text-muted",
  accent: "border-transparent bg-accent-soft text-accent",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs",
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
