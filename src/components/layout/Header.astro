---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "../../data/profile";

const navItems = [
  { id: "sobre-mi", label: "Sobre mí" },
  { id: "proyectos", label: "Proyectos" },
  { id: "cv", label: "CV" },
];

const linkClasses =
  "relative block rounded-lg px-3 py-2 text-sm text-text-muted hover:text-text aria-[current=true]:text-text after:absolute after:inset-x-3 after:bottom-1 after:h-px after:bg-accent after:opacity-0 after:transition-opacity after:duration-200 aria-[current=true]:after:opacity-100";
---

<header
  data-site-header
  class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md"
>
  <nav
    aria-label="Principal"
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6"
  >
    <a
      href="#inicio"
      aria-label={`${profile.name}, ir al inicio`}
      class="font-mono text-sm font-medium"
    >
      <span class="before:text-accent before:content-['~/']">
        {profile.handle}
      </span>
    </a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {navItems.map((item) => (
          <li>
            <a href={`#${item.id}`} data-nav-link class={linkClasses}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        class="group relative isolate inline-flex size-10 items-center justify-center overflow-hidden rounded-lg text-text-muted hover:text-text md:hidden"
      >
        <span
          aria-hidden="true"
          class="absolute inset-0 -z-10 bg-text/6 opacity-0 transition-opacity duration-200 group-hover:opacity-100"
        ></span>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="size-5 group-aria-expanded:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="hidden size-5 group-aria-expanded:block"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="menu-movil"
    data-menu-panel
    hidden
    class="border-t border-border md:hidden"
  >
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3">
      {navItems.map((item) => (
        <li>
          <a href={`#${item.id}`} data-nav-link class={linkClasses}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const button =
    document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  // Menú móvil (RF-02): se cierra con Esc, al elegir un enlace o al pulsar
  // fuera; con Esc el foco vuelve al botón.
  if (header && button && panel) {
    const isOpen = () => button.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean, returnFocus = false) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      panel.hidden = !open;
      if (!open && returnFocus) button.focus();
    };

    button.addEventListener("click", () => setOpen(!isOpen()));

    for (const link of panel.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false));
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) setOpen(false, true);
    });

    document.addEventListener("click", (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });

    matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // Resalta el enlace de la sección visible. Se observan todas las secciones
  // con id, para que al volver al inicio no quede ningún enlace marcado.
  const navLinks =
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const sections = document.querySelectorAll<HTMLElement>("main section[id]");

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of navLinks) {
          if (link.hash === `#${entry.target.id}`) {
            link.setAttribute("aria-current", "true");
          } else {
            link.removeAttribute("aria-current");
          }
        }
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );

  for (const section of sections) observer.observe(section);
</script>
